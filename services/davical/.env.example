# Copy to .env next to docker-compose.yml and edit.
#   openssl rand -hex 32    # for SECRET_KEY

# PostgreSQL password for the `davical` role (used by both the db service and
# the DATABASE/OWNER_DSN connection strings). Must be set — compose refuses to
# start without it. Percent-encode any of @ : / ? # [ ] in it.
DAVICAL_DB_PASSWORD=change-me

# Server Olson timezone; also the fallback for iCalendar data with an
# unresolvable TZID. tzdata is embedded in the binary, so any Olson name works.
TZ=Pacific/Auckland

# Name shown at the root of the server and in AUTH realms.
SERVER_DISPLAYNAME=DAViCal CalDAV Server

# Where to bind on the host. Keep it on loopback and terminate TLS in a proxy.
DAVICAL_HTTP_ADDR=127.0.0.1:8080

# RFC 6638 scheduling (calendar invitations) and auto accept/decline.
ENABLE_SCHEDULING=true
ENABLE_AUTO_SCHEDULE=true

# Required for the /adm/ set-password + forgotten-password flows. Rotating it
# invalidates outstanding tokens.
SECRET_KEY=

# Externally-visible base URL (no trailing slash) for set-password links.
BASE_URL=https://dav.example.org

# Outbound mail (only used when SMTP_HOST is set).
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_FROM=davical@example.org
#SMTP_USERNAME=
#SMTP_PASSWORD=
