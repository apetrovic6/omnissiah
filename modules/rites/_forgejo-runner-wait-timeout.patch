+func TestBoundedSingleTaskPoller_ReplaysFetchAndRunsPastPickupDeadline(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		cfg := &config.Config{}
+		cfg.Runner.FetchTimeout = time.Second
+		handle := "job-handle"
+		pickupCtx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+		defer cancel()
+
