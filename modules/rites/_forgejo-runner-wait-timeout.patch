+func declareForPickup(ctx context.Context, runner *run.Runner, labels []string) error {
+	for {
+		if err := ctx.Err(); err != nil {
+			if errors.Is(err, context.DeadlineExceeded) {
+				return poll.ErrNoTaskReceived
+			}
+			return err
+		}
+		_, _, err := declareRunner(ctx, runner, labels)
+		if err == nil {
+			return nil
+		}
+		switch connect.CodeOf(err) {
+		case connect.CodeUnavailable, connect.CodeDeadlineExceeded, connect.CodeUnknown, connect.CodeInternal:
+			// Retry transient startup failures without restarting the pickup clock.
+			select {
+			case <-ctx.Done():
+			case <-time.After(time.Second):
+			}
+		default:
+			if ctx.Err() == nil {
+				return err
+			}
+		}
+	}
