+func TestBoundedSingleTaskPoller_ReplaysFetchAndRunsPastPickupDeadline(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		cfg := &config.Config{}
+		cfg.Runner.FetchTimeout = time.Second
+		handle := "job-handle"
+		pickupCtx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+		defer cancel()
+
+		mockClient := mock_client.NewMockClient(t)
+		mockClient.On("Address").Return("https://example.com/forgejo")
+		mockClient.On("FetchInterval").Return(time.Second)
+		var keys []gouuid.UUID
+		mockClient.EXPECT().SetRequestKey(mock.Anything).Run(func(key gouuid.UUID) {
+			keys = append(keys, key)
+		}).Return(func() {}).Twice()
+		req := connect.NewRequest(&runnerv1.FetchSingleTaskRequest{Handle: &handle})
+		mockClient.EXPECT().FetchSingleTask(mock.Anything, req).
+			RunAndReturn(func(ctx context.Context, _ *connect.Request[runnerv1.FetchSingleTaskRequest]) (*connect.Response[runnerv1.FetchSingleTaskResponse], error) {
+				start := time.Now()
+				<-ctx.Done()
+				require.ErrorIs(t, ctx.Err(), context.DeadlineExceeded)
+				require.Equal(t, cfg.Runner.FetchTimeout, time.Since(start))
+				return nil, ctx.Err()
+			}).Once()
+		task := &runnerv1.Task{}
+		mockClient.EXPECT().FetchSingleTask(mock.Anything, req).
+			Return(connect.NewResponse(&runnerv1.FetchSingleTaskResponse{Task: task}), nil).Once()
+
+		mockRunner := mock_runner.NewMockRunner(t)
+		mockRunner.On("Run", mock.Anything, task).Run(func(args mock.Arguments) {
+			ctx := args.Get(0).(context.Context)
+			<-pickupCtx.Done()
+			require.NoError(t, ctx.Err())
+		}).Once()
+
+		poller := NewBoundedSingleTaskPoller(t.Context(), pickupCtx, cfg, mockClient, mockRunner, &handle)
+		require.NoError(t, poller.Poll())
+		require.Len(t, keys, 2)
+		require.NotEqual(t, gouuid.Nil, keys[0])
+		require.Equal(t, keys[0], keys[1])
+	})
+}
