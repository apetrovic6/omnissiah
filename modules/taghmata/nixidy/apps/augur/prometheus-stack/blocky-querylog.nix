# Grafana's view of Blocky's query log (Postgres on cerberus).
#
#   - datasource: a SopsSecret generated by reliquary/blocky-grafana (one clan var,
#     also the role's password on cerberus). Its Secret carries the label
#     `grafana_datasource`, and the Grafana datasource sidecar (kube-prometheus-stack
#     default: enabled, label grafana_datasource, resource=both, searchNamespace unset
#     = its own namespace, observability) writes it into Grafana's provisioning
#     directory. So default.nix needs no change.
#     `grafana.forceDeployDatasources = false` there only controls whether the chart's
#     OWN datasource ConfigMap is rendered when Grafana itself is disabled; it has no
#     effect on sidecar-loaded Secrets/ConfigMaps like this one.
#   - dashboard: Blocky's bundled Postgres dashboard, in a ConfigMap labelled
#     `grafana_dashboard` (the dashboard sidecar, same as the Garage one). The vendored
#     JSON (./blocky-query-postgres.json, from blocky's docs/) is an EXPORT: it names
#     its datasource with the import placeholder `${DS_POSTGRES}`, which provisioning
#     does not substitute. It is replaced here with a reference to the provisioned
#     datasource's uid, and the `__inputs` block that only the import UI reads is dropped.
#
# The credential file is guarded like the ntfy/heartbeat ones in default.nix: the
# flake evaluates before `clan vars generate cerberus --generator blocky-grafana`.
{...}: {
  nixidy.envs.prod.apps.prometheus-blocky-querylog = {
    lib,
    vars,
    ...
  }: let
    datasourceUid = "blocky-querylog";
    datasourceSecretYaml = vars.shared "blocky-grafana" "grafana-datasource";
    datasourceReady = builtins.pathExists datasourceSecretYaml;

    datasourceRef = {
      type = "grafana-postgresql-datasource";
      uid = datasourceUid;
    };
    # Replace every `"datasource": "${DS_POSTGRES}"` (panels, targets, variables).
    rewrite = v:
      if builtins.isAttrs v
      then
        lib.mapAttrs (
          n: x:
            if n == "datasource" && x == "\${DS_POSTGRES}"
            then datasourceRef
            else rewrite x
        )
        v
      else if builtins.isList v
      then map rewrite v
      else v;
    dashboard = removeAttrs (rewrite (builtins.fromJSON (builtins.readFile ./blocky-query-postgres.json))) ["__inputs"];
  in {
    applications.prometheus-grafana = {
      yamls = lib.optionals datasourceReady [(builtins.readFile datasourceSecretYaml)];

      resources.configMaps.blocky-query-dashboard = {
        metadata = {
          namespace = "observability";
          labels.grafana_dashboard = "1";
        };
        data."blocky-query-postgres.json" = builtins.toJSON dashboard;
      };
    };
  };
}
